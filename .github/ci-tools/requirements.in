# Scanners the SAST and weekly SCA jobs run. Installed into their own venv,
# hash-checked, so a compromised or yanked release cannot run in CI unnoticed.
# Regenerate after editing:
#   uv pip compile .github/ci-tools/requirements.in --python-version 3.11 --python-platform x86_64-manylinux_2_28 --only-binary :all: --generate-hashes --output-file .github/ci-tools/requirements.lock
semgrep
bandit
pip-audit
