# Non-secret LLM selection. "auto" detects a single configured credential.
# Other values: azure_openai, openai, anthropic, google, deepseek, xai, meta,
# or openai_compatible.
# Credentials belong in the ignored .env.secrets file, never in source code.
LLM_PROVIDER=auto
# Optional for providers with a built-in default; always set this to pin behavior.
LLM_MODEL=
# Enable only for local development; never enable this in production.
FLASK_DEBUG=false
# Used only with LLM_PROVIDER=azure_openai.
AZURE_OPENAI_API_VERSION=2024-12-01-preview
# Leave blank to use the deployment's supported default temperature.
LLM_TEMPERATURE=
AI_REQUEST_TIMEOUT_SECONDS=180
TRACE_DIR=instance/traces
# Flight Agent's inventory source: "seed" (the project's static dataset — the
# default, and what the golden scenarios are pinned to) or "duffel" (live
# supplier search; needs DUFFEL_API_TOKEN in .env.secrets).
FLIGHT_INVENTORY_SOURCE=seed
DUFFEL_API_VERSION=v2
DUFFEL_TIMEOUT_SECONDS=30
# Duffel's own wait-for-airlines cap in ms (2000-60000). Keep it below
# DUFFEL_TIMEOUT_SECONDS so partial results come back before we time out.
DUFFEL_SUPPLIER_TIMEOUT_MS=20000
DUFFEL_MAX_OFFERS=50
DATABASE=instance/travel_planner.sqlite3
# Hosted Postgres. Leave unset for local SQLite development.
# Supabase: use the SESSION POOLER string (host contains pooler.supabase.com),
# not the direct connection — the direct endpoint is IPv6-only and Render
# cannot reach it. Percent-encode any /, @, # or ? in the password.
# The value itself is a secret and belongs in .env.secrets, never here.
# Commented out, not just blank: config.py loads .env before .env.secrets
# with override=False, and python-dotenv treats an empty value as already
# set -- so an empty DATABASE_URL= here would shadow the real one in
# .env.secrets and silently fall back to SQLite. Leave this line commented.
# DATABASE_URL=
MAX_INPUT_CHARS=12000
ACCESSIBILITY_SEARCH_TIMEOUT_SECONDS=12
# Optional comma-separated official/provider domains to add to the accessibility allowlist.
ACCESSIBILITY_EXTRA_DOMAINS=

# Browser login and session security. Generate a strong random SECRET_KEY.
SECRET_KEY=replace-with-a-long-random-value
LOGIN_EMAIL=demo@example.com
ADMIN_EMAIL=admin@example.com
# Optional comma-separated list. ADMIN_EMAIL remains supported for compatibility.
ADMIN_EMAILS=admin@example.com,second-admin@example.com
# Generate with: python -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('your-password'))"
LOGIN_PASSWORD_HASH=replace-with-a-generated-werkzeug-password-hash
SESSION_COOKIE_SECURE=false
