# Non-secret LLM selection. "auto" detects a single configured credential.
# Other values: azure_openai, openai, anthropic, google, deepseek, xai, meta,
# or openai_compatible.
# Credentials belong in the ignored .env.secrets file, never in source code.
LLM_PROVIDER=auto
# Optional for providers with a built-in default; always set this to pin behavior.
LLM_MODEL=
# Enable only for local development; never enable this in production.
FLASK_DEBUG=false
# Used only with LLM_PROVIDER=azure_openai.
AZURE_OPENAI_API_VERSION=2024-12-01-preview
# Leave blank to use the deployment's supported default temperature.
LLM_TEMPERATURE=
AI_REQUEST_TIMEOUT_SECONDS=180
TRACE_DIR=instance/traces
# Flight Agent's inventory source: "seed" (the project's static dataset — the
# default, and what the golden scenarios are pinned to) or "duffel" (live
# supplier search; needs DUFFEL_API_TOKEN in .env.secrets).
FLIGHT_INVENTORY_SOURCE=seed
DUFFEL_API_VERSION=v2
DUFFEL_TIMEOUT_SECONDS=30
# Duffel's own wait-for-airlines cap in ms (2000-60000). Keep it below
# DUFFEL_TIMEOUT_SECONDS so partial results come back before we time out.
DUFFEL_SUPPLIER_TIMEOUT_MS=20000
DUFFEL_MAX_OFFERS=50
DATABASE=instance/travel_planner.sqlite3
# Hosted Postgres. Leave unset for local SQLite development.
# Supabase: use the SESSION POOLER string (host contains pooler.supabase.com),
# not the direct connection — the direct endpoint is IPv6-only and Render
# cannot reach it. Percent-encode any /, @, # or ? in the password.
# The value itself is a secret and belongs in .env.secrets, never here.
# Commented out, not just blank: config.py loads .env before .env.secrets
# with override=False, and python-dotenv treats an empty value as already
# set -- so an empty DATABASE_URL= here would shadow the real one in
# .env.secrets and silently fall back to SQLite. Leave this line commented.
# DATABASE_URL=
MAX_INPUT_CHARS=12000
ACCESSIBILITY_SEARCH_TIMEOUT_SECONDS=12
# Serper external web search used only by the Accessibility Agent.
# Put the real secret in .env.secrets or the deployment secret store, never in Git.
# SERPER_API_KEY=
# Optional comma-separated official/provider domains treated as trusted evidence sources.
ACCESSIBILITY_EXTRA_DOMAINS=

# Official A2A 1.x sidecar for agent discovery and JSON-RPC communication.
# A2A_BASE_URL must be the externally reachable address in production.
A2A_BASE_URL=http://127.0.0.1:5000
A2A_HOST=127.0.0.1
A2A_PORT=5000
# Enabled automatically by scripts.run_all/asgi.py. Leave false for Flask-only
# startup because that process does not expose the A2A routes.
A2A_INTERNAL_ENABLED=false

# --- L2 guardrails: the LLM classifier -------------------------------------
# Screens traveller free text before planning and the synthesized plan before
# it is shown. Runs after the deterministic schema and regex gates, so it only
# ever costs a call for input those already cleared.
# Set false to develop offline; L0/L1 keep working either way.
GUARDRAIL_LLM_ENABLED=true
# Shared default for both gates; blank inherits LLM_MODEL.
GUARDRAIL_LLM_MODEL=
# Per-gate overrides; blank inherits GUARDRAIL_LLM_MODEL. The two gates want
# opposite things:
#   INPUT  runs first, traveller waiting, reading attacker text, fail-closed.
#          Wants small and fast — its p95 latency is an availability number.
#   OUTPUT runs after ~75s of planning and judges our own model's prose.
#          Two extra seconds is noise; it can afford a more capable model.
# Which model goes where is a measurement. Run scripts/guardrail_eval.py and
# read the per-gate sections before setting these.
GUARDRAIL_INPUT_LLM_MODEL=
GUARDRAIL_OUTPUT_LLM_MODEL=
# Deliberately not AI_REQUEST_TIMEOUT_SECONDS: under fail-closed, a 180-second
# guardrail turns a slow provider into a three-minute wait before a refusal.
# This one governs the INPUT gate.
GUARDRAIL_LLM_TIMEOUT_SECONDS=8
# The OUTPUT gate's own budget, independent of the line above — raising one does
# not raise the other. Larger because a timeout here throws away a plan that
# five agent calls just paid for.
GUARDRAIL_OUTPUT_LLM_TIMEOUT_SECONDS=20
# A "block" below this confidence is recorded as a flag instead of denying the
# traveller. Tune from docs/security/guardrail-eval-report.md, not by feel.
GUARDRAIL_BLOCK_THRESHOLD=0.7
# "closed" (a classifier error blocks) or "open" (it flags and proceeds behind
# L0/L1). Fail-open is a deliberate, visible choice, never a silent fallback.
GUARDRAIL_FAIL_MODE=closed
# L1 PII redaction on the intake prompt, before the prompt reaches the L2
# classifier, the extraction model, or the intake_messages table. It redacts and
# lets planning continue; it never denies the traveller. Turn it off only for
# local debugging.
PII_REDACTION_ENABLED=true

# Browser login and session security. Generate a strong random SECRET_KEY.
SECRET_KEY=replace-with-a-long-random-value
LOGIN_EMAIL=demo@example.com
ADMIN_EMAIL=admin@example.com
# Optional comma-separated list. ADMIN_EMAIL remains supported for compatibility.
ADMIN_EMAILS=admin@example.com,second-admin@example.com
# Generate with: python -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('your-password'))"
LOGIN_PASSWORD_HASH=replace-with-a-generated-werkzeug-password-hash
SESSION_COOKIE_SECURE=false

# --- Agent2Agent (A2A) -------------------------------------------------------
# How the orchestrator reaches the flight agent.
#   inprocess  (default) call the node directly - fastest, one audit chain,
#              no second process to keep alive.
#   a2a        route the call over the real Agent2Agent protocol.
# Resolved once when the graph is built, so it cannot change mid-plan. This is
# the one-variable revert if the A2A path misbehaves.
FLIGHT_AGENT_TRANSPORT=inprocess
# Defaults to <A2A_BASE_URL>/a2a/flight_agent when blank.
FLIGHT_AGENT_A2A_URL=
FLIGHT_AGENT_A2A_TIMEOUT_SECONDS=60

# Which agent answers at /.well-known/agent-card.json. Point this at
# flight_agent to put that agent alone in front of a conformance run.
A2A_ROOT_AGENT=orchestrator_agent

# Whether an A2A caller may name the request id its work is recorded under.
# That id is a write key into an existing audit trail, so enable this only when
# the endpoint is not reachable by strangers. Required for FLIGHT_AGENT_TRANSPORT=a2a
# to keep one unbroken audit chain across the hop.
A2A_TRUST_CALLER_REQUEST_ID=false
