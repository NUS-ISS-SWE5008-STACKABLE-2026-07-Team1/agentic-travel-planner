# Copy this file to .env.secrets. The destination is ignored by Git.
# Keep only the credentials for your selected LLM provider.

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=replace-with-a-newly-rotated-key

# OpenAI (remove these when using Azure OpenAI)
OPENAI_API_KEY=replace-with-a-newly-created-key
# Optional OpenAI-compatible endpoint; normally leave blank for OpenAI.
OPENAI_BASE_URL=

# Anthropic
ANTHROPIC_API_KEY=

# Google Gemini / Google AI Studio
GOOGLE_API_KEY=

# DeepSeek
DEEPSEEK_API_KEY=

# xAI
XAI_API_KEY=

# Hosted Meta model (the hosting vendor supplies the endpoint and model ID)
META_API_KEY=
META_BASE_URL=

# Any other OpenAI-compatible resource
LLM_API_KEY=
LLM_BASE_URL=

# External web evidence search used only by the Accessibility Agent.
SERPER_API_KEY=

# Duffel flight inventory. Only read when FLIGHT_INVENTORY_SOURCE=duffel.
# Sandbox tokens start duffel_test_ and return Duffel Airways data, which is
# deliberately NOT realistic in price or schedule; live tokens start duffel_live_.
DUFFEL_API_TOKEN=
