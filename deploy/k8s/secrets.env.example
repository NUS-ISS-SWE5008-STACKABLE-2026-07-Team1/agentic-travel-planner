# Keys the `app-secrets` Secret must contain. Values are never committed.
#
# 1. Copy this file OUTSIDE the repository (so it cannot be committed), e.g.
#      Copy-Item deploy\k8s\secrets.env.example $HOME\travel-planner-secrets.env
# 2. Fill in the values. No quotes; one KEY=value per line.
# 3. Load it into the cluster:
#      kubectl create secret generic app-secrets -n travel-planner --from-env-file=$HOME\travel-planner-secrets.env
# 4. Delete the local copy.

# The provider key. Spends money on every plan.
OPENAI_API_KEY=

# Accessibility evidence retrieval. Optional: absent degrades visibly.
SERPER_API_KEY=

# Supabase SESSION POOLER DSN (host contains pooler.supabase.com), same value
# as the Render dashboard. The password travels separately in PGPASSWORD.
DATABASE_URL=
PGPASSWORD=

# Signs session cookies. Any long random string; generate one with
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Comma-separated emails allowed into /admin.
ADMIN_EMAILS=
